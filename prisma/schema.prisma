// OpyCampus — production-grade social platform for students & institutions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  name          String
  bio           String?
  avatarUrl     String?
  coverUrl      String?
  location      String?
  website       String?
  password      String   // scrypt hash, format "salt:hash"
  role          String   @default("student") // student | teacher | institution_admin
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institutionId String?
  institution   Institution? @relation("InstitutionMembers", fields: [institutionId], references: [id], onDelete: SetNull)
  department    String?

  sessions      Session[]
  posts         Post[]
  likes         Like[]
  bookmarks     Bookmark[]
  reposts       Repost[]
  followsGiven  Follow[]     @relation("FollowFollower")
  followsRecv   Follow[]     @relation("FollowFollowing")
  memberships   InstitutionMember[]
  institutionsOwned Institution[] @relation("InstitutionOwner")
  communitiesOwned Community[]
  communityMemberships CommunityMember[]
  attachments   Attachment[]
  notifications Notification[] @relation("NotifTo")
  notifTrigger  Notification[] @relation("NotifActor")
  // DMs
  conversationsStarted Conversation[] @relation("ConvStarter")
  conversationsPartOf  ConversationMember[]
  messagesSent  Message[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique // sha256 hash of the cookie token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Institution {
  id          String   @id @default(cuid())
  name        String
  handle      String   @unique
  type        String   @default("university") // school | college | university | institute
  bio         String?
  logoUrl     String?
  coverUrl    String?
  website     String?
  location    String?
  verified    Boolean  @default(false)
  isPrivate   Boolean  @default(false)
  ownerId     String?  // creator / admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User?     @relation("InstitutionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members     InstitutionMember[]
  posts       Post[]
  users       User[]      @relation("InstitutionMembers")
}

model InstitutionMember {
  id            String   @id @default(cuid())
  institutionId String
  userId        String
  role          String   @default("member") // admin | teacher | student | member
  approved      Boolean  @default(true)
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
}

model Community {
  id          String   @id @default(cuid())
  name        String
  handle      String   @unique
  description String?
  iconUrl     String?
  coverUrl    String?
  category    String   @default("study") // study | club | hobby | course | project | other
  isPrivate   Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  posts       Post[]
}

model CommunityMember {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  role        String   @default("member") // owner | admin | member
  joinedAt    DateTime @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
}

model Post {
  id           String   @id @default(cuid())
  content      String
  media        String?  // JSON array of {url, type:"image"|"video"} — real uploaded files
  authorId     String
  institutionId String? // posted inside an institution feed
  communityId  String?  // posted inside a community
  parentId     String?  // null = top-level; set = reply
  tags         String?  // comma-separated hashtags
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  community    Community?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  parent       Post?       @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Post[]      @relation("PostReplies")
  likes        Like[]
  bookmarks    Bookmark[]
  reposts      Repost[]
  notifications Notification[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model Repost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // like | follow | reply | repost | mention | institution | community
  toUserId  String
  actorId   String?
  postId    String?
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  toUser    User  @relation("NotifTo", fields: [toUserId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)
  post      Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
}

model Attachment {
  id         String   @id @default(cuid())
  filename   String   // stored filename on disk
  originalName String
  mimeType   String
  size       Int
  uploaderId String
  createdAt  DateTime @default(now())

  uploader   User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  starterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  starter   User @relation("ConvStarter", fields: [starterId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
